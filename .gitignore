# Run workspaces and outputs
runs/
out/*
!out/.gitkeep

# Edit intermediates and the prefix cache — rebuildable from the edit list
editwork/
**/editwork/
.editcache/
input/*
!input/.gitkeep

# The spend ledger is machine state, not source
budget.json
*.corrupt-*.json

# Scraped and generated media
*.mp4
*.mp3
*.wav
*.m4a
*.png
!docs/*.png
!tests/fixtures/*.png

# Source videos you send for editing are tracked on purpose — this is the
# route into the session, since chat attachments cap out well below a typical
# phone video. Keep them under 100 MB (GitHub's hard limit per file).
!uploads/**

# Finished cuts are tracked too — chat attachments cap at 30 MB and a
# finished 1080p minute clears that easily, so the repo is the delivery route.
!deliverables/**

# Bizzy Bee project assets: source clips, generated footage, scrims, output
!bizzybee/**

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
node_modules/
